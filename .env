# MetaAgent-Epi shared runtime defaults

# Network
NO_PROXY=localhost,127.0.0.1,::1

# Default provider
LLM_PROVIDER=openai

# Shared runtime defaults
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0.1

# Shared MinerU defaults
MINERU_BASE_URL=https://mineru.net
MINERU_ENDPOINT=/api/v4/extract/task
MINERU_TIMEOUT_S=180
MINERU_NO_PROXY=true
MINERU_RETRY_ATTEMPTS=3
MINERU_RETRY_BASE_DELAY_S=1


# Shared LangSmith defaults
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
