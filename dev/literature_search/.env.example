## MetaAgent-Epi Literature Search module overrides
##
## Copy to `dev/literature_search/.env.local` only if this module needs values
## different from shared defaults in `dev/.env(.local)`.

## Optional LLM overrides for literature_search only
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4.1
# LLM_API_KEY=your_literature_search_llm_key_here
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=32000
# LLM_TIMEOUT_S=120
# LLM_VERIFY_SSL=false

## Web scoping
# TAVILY_API_KEY=your_tavily_key_here
# SERPER_API_KEY=your_serper_key_here

## LangSmith overrides
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=metaagent_literature_search
# LANGSMITH_TRACING=false
# LANGSMITH_TRACING_V2=false

## NCBI / PubMed
# NCBI_API_KEY=your_ncbi_api_key_here
# NCBI_EMAIL=your_email@example.com
# NCBI_VERIFY_SSL=false
# PUBMED_FIXMISSING_VERBOSE=0
# PUBMED_BATCH_SLEEP_S=0.1

## CrossRef / ERIC
# CROSSREF_MAILTO=your_email@example.com
# ERIC_API_BASE=https://api.ies.ed.gov/eric/
