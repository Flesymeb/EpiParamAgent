# ==============================================================================
# MetaAgent-Epi Literature Search Configuration
# ==============================================================================
# This file contains configuration for the epidemiology literature search system.
# Copy this file to .env and fill in your API keys.

# ==============================================================================
# LLM API Configuration
# ==============================================================================
# Choose your LLM provider (anthropic, openai, siliconflow, etc.)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# API Keys (provide the one matching your LLM_PROVIDER)
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# For custom providers (e.g., SiliconFlow):
#LLM_PROVIDER=siliconflow
#LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#OPENAI_API_KEY=your_siliconflow_api_key
#OPENAI_API_BASE=https://api.siliconflow.cn/v1

# ==============================================================================
# DATA SOURCE API KEYS
# ==============================================================================

# ------------------
# PubMed/NCBI (Primary data source - FREE)
# ------------------
# HIGHLY RECOMMENDED: Get free API key from https://www.ncbi.nlm.nih.gov/account/
# Without API key, you're limited to 3 requests/second
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com

# ------------------
# Embase (Optional - REQUIRES INSTITUTIONAL SUBSCRIPTION)
# ------------------
# Embase requires paid institutional access through Elsevier
# Visit: https://dev.elsevier.com/ for API key application
# Contact your institution's library for credentials
EMBASE_API_KEY=your_elsevier_api_key_here
EMBASE_INST_TOKEN=your_institution_token_here

# NOTE: Embase integration is partially implemented (placeholder)
# Options for Embase access:
#   1. Use institutional API if available
#   2. Export Embase results manually and import alongside PubMed
#   3. Use PubMed/MEDLINE alone (covers ~95% of biomedical literature)

# ------------------
# Optional: Web Search for Scoping (Tavily/Serper)
# ------------------
# Used for initial term discovery, not formal literature retrieval
TAVILY_API_KEY=your_tavily_key_here
SERPER_API_KEY=your_serper_key_here

# ------------------
# Optional: Semantic Scholar (Cross-database search)
# ------------------
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# ==============================================================================
# Optional: LangSmith Tracing (for debugging LLM calls)
# ==============================================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=metaagent-epi-literature-search

# ==============================================================================
# Search & Agent Configuration (Optional - uses defaults if not set)
# ==============================================================================
# AGENT_MAX_ITERATIONS=10
# AGENT_TEMPERATURE=0.7
# MAX_PAPERS_PER_SEARCH=100
# DEFAULT_DATE_RANGE_YEARS=10

# ==============================================================================
# Storage Paths (Optional - uses defaults if not set)
# ==============================================================================
# LITERATURE_WORKDIR=./langgraph_runs
# DATA_DIR=./data
# LOG_LEVEL=INFO
