## MetaAgent-Epi Literature Search .env

## LLM Configuration
# LLM_PROVIDER=openai
LLM_MODEL=deepseek/deepseek-v3.2 #openai/gpt-5.2
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://openrouter.ai/api/v1

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://openrouter.ai/api/v1

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

## Web Scoping (optional)
TAVILY_API_KEY=your_tavily_key_here
SERPER_API_KEY=your_serper_key_here

## LangSmith (optional)
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=metaagent_literature_search
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false

## NCBI / PubMed
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com
NCBI_VERIFY_SSL="false"

## CrossRef (optional)
CROSSREF_MAILTO=your_email@example.com

## Storage & Logging
DATA_DIR=./data
METADATA_DIR=./data/metadata
LOG_LEVEL=INFO
LOG_FILE=./logs/research_pilot.log

## Unused/Legacy (kept for reference)
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=research_papers
# CUDA_VISIBLE_DEVICES=0
# USE_GPU=true
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# EMBEDDING_BATCH_SIZE=128
# EMBEDDING_DEVICE=cuda
# MAX_PAPERS_PER_SEARCH=20
# MIN_CITATION_COUNT=10
# DEFAULT_DATE_RANGE_YEARS=5
# AGENT_MAX_ITERATIONS=10
# AGENT_TEMPERATURE=0.7
# AGENT_MAX_TOKENS=2048
# PAPERS_DIR=./data/papers
# EMBEDDINGS_DIR=./data/embeddings
# USE_LOCAL_LLM=false
