## literature_search module overrides
##
## Copy to dev/literature_search/.env.local
## Shared secrets (API keys, NCBI, MinerU, proxy) go in dev/.env.local — not here.

## LLM — screening uses a more capable model and longer timeout
# LLM_MODEL=openai/gpt-5.4
# LLM_TIMEOUT_S=300

## Web search (literature_search only)
# TAVILY_API_KEY=your_tavily_key_here
# SERPER_API_KEY=your_serper_key_here

## LangSmith
# LANGSMITH_PROJECT=metaagent_literature_search
