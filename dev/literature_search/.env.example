## MetaAgent-Epi Literature Search overrides
## Prefer shared defaults in dev/.env. Keep only literature_search-specific overrides here.

## LLM
# LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.2
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=
# LLM_TIMEOUT_S=
# LLM_VERIFY_SSL=true

## Optional provider keys (uncomment if needed)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# QWEN_API_KEY=your_qwen_api_key_here
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

## Web Scoping (optional)
TAVILY_API_KEY=your_tavily_key_here
SERPER_API_KEY=your_serper_key_here

## LangSmith (optional)
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=metaagent_literature_search
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false

## NCBI / PubMed
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com
NCBI_VERIFY_SSL=false
# PUBMED_API_KEY=your_pubmed_api_key_here

## CrossRef / ERIC (optional)
CROSSREF_MAILTO=your_email@example.com
# ERIC_API_BASE=https://api.ies.ed.gov/eric/
# CROSSREF_DOI_LOOKUP_MAX=200

## Runtime (optional)
# LITERATURE_WORKDIR=./langgraph_runs
