# MetaAgent-Epi shared runtime defaults

# Put values here when both literature_search and coding_sheet should use the
# same provider/runtime.

# LLM
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.2
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=32000
# LLM_TIMEOUT_S=120
# LLM_VERIFY_SSL=true

# MinerU
# MINERU_API_KEY=your_mineru_api_key_here
# MINERU_BASE_URL=https://mineru.net
# MINERU_ENDPOINT=/api/v4/extract/task
# MINERU_TIMEOUT_S=180

# LangSmith
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=metaagent_epi
# LANGSMITH_TRACING=false
# LANGSMITH_TRACING_V2=false
