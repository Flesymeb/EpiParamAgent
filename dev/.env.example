# MetaAgent-Epi shared defaults and machine-local secrets template
#
# Layout:
#   dev/.env          — shared non-secret defaults (committed)
#   dev/.env.local    — shared machine-local secrets (gitignored, copy from this file)
#   dev/{module}/.env.local — module-specific overrides only (LLM_MODEL, project name, etc.)

## System proxy (e.g. Clash)
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1,10.x.x.x,mineru.net

## Shared LLM (OpenRouter or any OpenAI-compatible provider)
# LLM_API_KEY=your_openrouter_or_provider_key_here
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_VERIFY_SSL=false

## Shared MinerU
# MINERU_API_KEY=your_mineru_api_key_here

## Shared NCBI / PubMed (used by both literature_search and coding_sheet)
# NCBI_API_KEY=your_ncbi_api_key_here
# NCBI_EMAIL=your_email@example.com
# NCBI_VERIFY_SSL=false
# PUBMED_FIXMISSING_VERBOSE=0
# PUBMED_BATCH_SLEEP_S=0.1

## Shared CrossRef
# CROSSREF_MAILTO=your_email@example.com

## Shared LangSmith
# LANGSMITH_API_KEY=your_langsmith_key_here
