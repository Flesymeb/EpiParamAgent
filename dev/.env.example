# MetaAgent-Epi shared runtime defaults
#
# Recommended layout:
# - shared defaults and shared secrets: dev/.env or dev/.env.local
# - module-specific differences: dev/literature_search/.env.local or
#   dev/coding_sheet/.env.local
#
# Prefer module .env.local overrides over module .env files for new setups.

## Shared LLM defaults
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.2
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=32000
# LLM_TIMEOUT_S=120
# LLM_VERIFY_SSL=true

## Shared MinerU defaults
# MINERU_API_KEY=your_mineru_api_key_here
# MINERU_BASE_URL=https://mineru.net
# MINERU_ENDPOINT=/api/v4/extract/task
# MINERU_TIMEOUT_S=180

## Shared LangSmith defaults
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=metaagent_epi
# LANGSMITH_TRACING=false
# LANGSMITH_TRACING_V2=false

## Optional network defaults
# NO_PROXY=localhost,127.0.0.1,::1
