# Example environment variables for MetaAgent coding sheet module

# LLM configuration
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4.1
# Prefer OPENAI_API_KEY / ANTHROPIC_API_KEY; LLM_API_KEY is also supported
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=

# OpenAI-compatible base URL (optional, e.g. OpenRouter)
LLM_API_BASE=
OPENAI_API_BASE=

# Optional generation params
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=metaagent_coding_sheet
LANGSMITH_TRACING=true
LANGSMITH_TRACING_V2=true

# MinerU (PDF -> Markdown) configuration
MINERU_BASE_URL=
MINERU_API_KEY=
MINERU_ENDPOINT=/api/v4/extract/task
MINERU_TIMEOUT_S=180
