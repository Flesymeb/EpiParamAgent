## MetaAgent-Epi Coding Sheet module overrides
##
## Copy to `dev/coding_sheet/.env.local` only if this module needs values
## different from shared defaults in `dev/.env(.local)`.

## Optional network override
# NO_PROXY=localhost,127.0.0.1,::1

## Optional LLM overrides for coding_sheet only
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-v3-huawei-910b
# LLM_API_KEY=your_coding_sheet_llm_key_here
# LLM_API_BASE=https://your-provider.example/v1/
# LLM_MAX_TOKENS=80000
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_S=120
# LLM_VERIFY_SSL=false

## MinerU overrides
# MINERU_API_KEY=your_mineru_api_key_here
# MINERU_BASE_URL=https://mineru.net
# MINERU_ENDPOINT=/api/v4/extract/task
# MINERU_TIMEOUT_S=180

## LangSmith overrides
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=metaagent_coding_sheet
# LANGSMITH_TRACING=false
# LANGSMITH_TRACING_V2=false
