# MetaAgent-Epi Coding Sheet overrides
# Prefer shared defaults in dev/.env. Keep only coding_sheet-specific overrides here.

# Network (optional)
# NO_PROXY=localhost,127.0.0.1

# LLM
LLM_MODEL=gpt-5.2
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=http://your_api_base/v1/
# LLM_MAX_TOKENS=80000
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT_S=

# MinerU
MINERU_API_KEY=your_mineru_api_key_here
MINERU_BASE_URL=
MINERU_ENDPOINT=/api/v4/extract/task
MINERU_TIMEOUT_S=180

# LangSmith (optional)
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=metaagent_coding_sheet
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
