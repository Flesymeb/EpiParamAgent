\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{metaagent-paper}[2026/05/12 Local MetaAgent paper style]

\RequirePackage[margin=0.82in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{libertinus}
\RequirePackage{libertinust1math}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{makecell}
\RequirePackage{caption}
\RequirePackage{xcolor}
\RequirePackage{float}
\RequirePackage{datetime2}
\RequirePackage{authblk}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage[super,sort&compress,numbers]{natbib}
\RequirePackage{hyperref}

\definecolor{MetaAgentInk}{HTML}{20242A}
\definecolor{MetaAgentMuted}{HTML}{5F6670}
\definecolor{MetaAgentRule}{HTML}{C8CDD6}
\definecolor{MetaAgentPromptBack}{HTML}{F7F8FA}
\definecolor{MetaAgentPromptFrame}{HTML}{D5DAE3}
\definecolor{MetaAgentPromptTitle}{HTML}{EEF1F5}

\geometry{letterpaper}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt minus 1pt}
\setlength{\textfloatsep}{14pt plus 2pt minus 2pt}
\setlength{\floatsep}{12pt plus 2pt minus 2pt}
\setlength{\intextsep}{12pt plus 2pt minus 2pt}
\hfuzz=10pt
\renewcommand{\arraystretch}{1.16}
\setlength{\tabcolsep}{5pt}

\captionsetup{
  font=small,
  labelfont=bf,
  textfont=normalfont,
  labelsep=colon,
  justification=raggedright,
  singlelinecheck=false,
  skip=6pt
}

\hypersetup{
  colorlinks=true,
  linkcolor=MetaAgentInk,
  citecolor=MetaAgentInk,
  urlcolor=blue
}
\renewcommand{\bibnumfmt}[1]{#1.}
\renewcommand\Authfont{\normalsize}
\renewcommand\Affilfont{\small\normalfont\color{MetaAgentMuted}}
\setlength{\affilsep}{0.25em}

\makeatletter
\renewenvironment{abstract}{%
  \par\vspace{0.7\baselineskip}%
  {\centering\large\bfseries\color{MetaAgentInk}Abstract\par}%
  \vspace{0.25\baselineskip}%
  \begingroup
  \begin{center}
  \begin{minipage}{0.92\textwidth}
  \normalsize
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0pt}%
}{%
  \par
  \end{minipage}
  \end{center}
  \endgroup\vspace{0.9\baselineskip}%
}
\renewcommand{\section}{\@startsection{section}{1}{0pt}%
  {1.3\baselineskip}{0.45\baselineskip}{\large\bfseries\color{MetaAgentInk}}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{0pt}%
  {1.0\baselineskip}{0.35\baselineskip}{\normalsize\bfseries\color{MetaAgentInk}}}
\makeatother

\newcommand{\metagent}{MetaAgent}
\newcommand{\nns}{NNS}
\newcommand{\pcite}[1]{\citep{#1}}
\newcommand{\papertable}[1]{\IfFileExists{tables/#1}{\input{tables/#1}}{\input{docs/paper/latex/tables/#1}}}
\newcommand{\promptvar}[1]{\texttt{\{#1\}}}
\newlist{promptitems}{itemize}{1}
\setlist[promptitems]{label=\textbullet,leftmargin=1.35em,itemsep=0.15em,topsep=0.2em,parsep=0pt}
\newtcolorbox{prompttemplate}[1]{%
  enhanced,
  breakable,
  colback=MetaAgentPromptBack,
  colframe=MetaAgentPromptFrame,
  colbacktitle=MetaAgentPromptTitle,
  coltitle=MetaAgentInk,
  fonttitle=\bfseries\small,
  fontupper=\footnotesize,
  before upper={\setlength{\parskip}{2pt}},
  title={#1},
  boxrule=0.45pt,
  arc=2pt,
  left=6pt,
  right=6pt,
  top=4pt,
  bottom=4pt,
  before skip=6pt,
  after skip=7pt,
  parbox=false
}
\newcommand{\verticalcell}[1]{\rotatebox[origin=c]{90}{\textbf{#1}}}
\newcommand{\paperfig}[3]{%
  \begin{figure}[t]
    \centering
    \includegraphics[width=#1\textwidth]{#2}
    \caption{#3}
  \end{figure}
}
