# Runtime workspace skeletons. Track only the README in each directory.
/dataset/*
!/dataset/README.md
/evaluation/*
!/evaluation/README.md
/paper_pool/*
!/paper_pool/README.md

# Keep only reusable CLI entrypoints under tools/scripts. One-off paper,
# baseline, and appendix scripts remain local.
/tools/scripts/*
!/tools/scripts/__init__.py
!/tools/scripts/evaluate_coding.py
!/tools/scripts/extract_coding.py
!/tools/scripts/pubmed_fix_missing.py
!/tools/scripts/pubmed_manager.py
!/tools/scripts/pubmed_search_titles.py
!/tools/scripts/screening_evaluation.py
!/tools/scripts/screening_llm_batch.py
!/tools/scripts/screening_prepare.py
!/tools/scripts/screening_report.py
/tools/paper_fetch/pmid.txt

