# MetaAgent-Epi configuration template — copy to .env.local and fill in

# ── System proxy ────────────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1,mineru.net,openxlab.org.cn,cdn-mineru.openxlab.org.cn,mineru.oss-cn-shanghai.aliyuncs.com,aliyuncs.com

# ── Workflow LLM selection ─────────────────────────────────
# These root-level settings replace the old metaagent/screening/.env.local
# and metaagent/coding/.env.local pattern.
QUERY_LLM_PROVIDER=pjlab
# QUERY_LLM_MODEL overrides the selected provider's model when set.
QUERY_LLM_MAX_TOKENS=6000
QUERY_LLM_TIMEOUT_S=120
QUERY_LLM_VERIFY_SSL=true
QUERY_LLM_TEMPERATURE=0.1
#
SCREENING_LLM_PROVIDER=pjlab
SCREENING_LLM_MAX_TOKENS=8000
SCREENING_LLM_TIMEOUT_S=120
SCREENING_LLM_VERIFY_SSL=true
SCREENING_LLM_TEMPERATURE=0.1
#
CODING_LLM_PROVIDER=pjlab
CODING_LLM_MAX_TOKENS=24000
CODING_LLM_TIMEOUT_S=120
CODING_LLM_VERIFY_SSL=true
CODING_LLM_TEMPERATURE=0.0
# Per-call process deadline includes quota waiting as well as the HTTP call.
CODING_LLM_SUBPROCESS_TIMEOUT_S=180
CODING_LLM_MAX_RETRIES=1
# The default LangExtract A and semantic B use JSON object envelopes.
# Explicit --extraction-backend llm uses a records object too; legacy arrays
# remain readable. Both backends work with this transport setting.
CODING_LLM_EXTRA_BODY_JSON={"response_format":{"type":"json_object"},"chat_template_kwargs":{"enable_thinking":false}}
# Conservative pacing for the current shared PJLab quota; not a model-speed claim.
METAAGENT_LLM_REQUESTS_PER_MINUTE=3.0

# Pi synthesis uses its own model profile for planning/code/validation/repair.
# Historical tasks without synthesis.backend retain deterministic synthesis.
SYNTHESIS_LLM_PROVIDER=pjlab
SYNTHESIS_LLM_MODEL=qwen3.8-27b-fp8
SYNTHESIS_LLM_THINKING=disabled
SYNTHESIS_LLM_MAX_TOKENS=8000
SYNTHESIS_LLM_TIMEOUT_S=120
SYNTHESIS_LLM_VERIFY_SSL=true
SYNTHESIS_LLM_TEMPERATURE=0.1
# Optional pinned local Pi executable. Version/resources are checked locally;
# credentials are relayed privately, never stored in task YAML or generated code.
# SYNTHESIS_PI_COMMAND=pi
# Agent budgets live in task.synthesis (max_turns/max_tokens/total_timeout_s/exec_timeout_s),
# separately from the per-model-call SYNTHESIS_LLM_MAX_TOKENS/TIMEOUT_S above.

# ── Shared LLM fallback ─────────────────────────────────────
# Used only when a module-specific value is not set.
LLM_PROVIDER=pjlab
# LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0.1
# LLM_VERIFY_SSL=true
# LLM_API_KEY=your_generic_openai_compatible_key
# LLM_API_BASE=https://api.openai.com/v1

# ── PJLab OpenAI-compatible gateway ─────────────────────────
PJLAB_BASE_URL=https://token.pjlab.org.cn/v1
PJLAB_MODEL=deepseek-v4.1-flash
# PJLAB_API_KEY=your_pjlab_key_here

# ── Optional self-hosted deployment ─────────────────────────
# SELFHOSTED_BASE_URL=http://s-20261029171829-x9cj8.ailab-ma4agismall.pjh-service.org.cn/v1
# SELFHOSTED_MODEL=deepseek-v4-flash-0731
# SELFHOSTED_API_KEY=empty
# Add the node host to NO_PROXY if your environment uses an HTTP proxy.

# ── MinerU PDF Parser ───────────────────────────────────────
# MINERU_API_KEY=your_key_here

# ── NCBI / PubMed ───────────────────────────────────────────
# NCBI_API_KEY=your_key_here
# NCBI_EMAIL=your_email
# NCBI_VERIFY_SSL=true

# ── Literature sources ──────────────────────────────────────
# Europe PMC, medRxiv, bioRxiv and Crossref do not require API keys.
# OpenAlex: optional personal key for an individual API budget.
# OPENALEX_API_KEY=
# Unpaywall requires a contact email (falls back to NCBI_EMAIL).
# UNPAYWALL_EMAIL=
# Optional contact email for Crossref requests.
# CROSSREF_EMAIL=
# Reserved for a future licensed Embase integration; not yet implemented.
# EMBASE_API_KEY=
# EMBASE_INST_TOKEN=

# ── Provider profile: Bailian / DashScope ───────────────────
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_API_KEY=your_bailian_key_here
# BAILIAN_MODEL=qwen3.7-plus

# ── LangSmith ────────────────────────────────────────────────
# LANGSMITH_API_KEY=your_key_here
# LANGSMITH_PROJECT=metaagent

# ── Provider profiles: OpenRouter ───────────────────────────
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# ── Provider profiles: Lab API 1 ────────────────────────────
# LAB_BASE_URL=http://8.130.18.34:5000/v1
# LAB_API_KEY=empty
# LAB_MODEL=deepseek-3.2

# ── Provider profiles: Lab API 2 ────────────────────────────
# LAB_BASE_URL_2=https://10.140.158.153:1020/dsv3/all/v1/
# LAB_API_KEY_2=your_lab2_key_here
# LAB_MODEL_2=deepseek-v3-huawei-910b

# ── Provider profiles: Boyue ────────────────────────────────
# BOYUE_BASE_URL=http://host.example/v1
# BOYUE_API_KEY=your_boyue_key_here
# BOYUE_MODEL=deepseek-v4-pro

# ── Provider profiles: custom OpenAI-compatible endpoint ────
# Choose any provider name and define uppercase env vars from that name.
# Example for LLM_PROVIDER=my-gpu:
# MY_GPU_BASE_URL=https://host.example/v1
# MY_GPU_API_KEY=your_key_here
# MY_GPU_MODEL=provider-native-model-id

# Parser/cache configuration (no credential values in task files)
MINERU_CACHE_POLICY=compatible
MINERU_MODEL_VERSION=vlm

# Web workspace (tasks, job history and private runtime overrides).
# The API never returns configured keys; an empty key in settings keeps it.
METAAGENT_WEB_WORKSPACE=runs/webapp
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_FRONTEND_HOST=127.0.0.1
WEB_FRONTEND_PORT=5173
# strict requires exact PDF + parser/config/implementation fingerprint.
# compatible also permits explicitly marked historical PMID caches.

# Verified for pjlab DeepSeek structured extraction: avoid reasoning-only budget exhaustion.
CODING_LLM_THINKING=disabled
SCREENING_LLM_MODEL=qwen3.8-27b-fp8
SCREENING_LLM_THINKING=disabled
SCREENING_LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}
CODING_LLM_MODEL=qwen3.8-27b-fp8
SYNTHESIS_LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}
