# MetaAgent-Epi configuration template — copy to .env.local and fill in

# ── System proxy ────────────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1,mineru.net,openxlab.org.cn,cdn-mineru.openxlab.org.cn,mineru.oss-cn-shanghai.aliyuncs.com,aliyuncs.com

# ── Workflow LLM selection ─────────────────────────────────
# These root-level settings replace the old metaagent/screening/.env.local
# and metaagent/coding/.env.local pattern.
# SCREENING_LLM_PROVIDER=lab2
# SCREENING_LLM_MODEL=deepseek-v3-huawei-910b
# SCREENING_LLM_MAX_TOKENS=8000
# SCREENING_LLM_TIMEOUT_S=120
# SCREENING_LLM_VERIFY_SSL=false
# SCREENING_LLM_TEMPERATURE=0.1
#
# CODING_LLM_PROVIDER=openrouter
# CODING_LLM_MODEL=z-ai/glm-5.1
# CODING_LLM_MAX_TOKENS=8000
# CODING_LLM_TIMEOUT_S=120
# CODING_LLM_VERIFY_SSL=true
# CODING_LLM_TEMPERATURE=0.0

# ── Shared LLM fallback ─────────────────────────────────────
# Used only when a module-specific value is not set.
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0.1
# LLM_VERIFY_SSL=true
# LLM_API_KEY=your_generic_openai_compatible_key
# LLM_API_BASE=https://api.openai.com/v1

# ── MinerU PDF Parser ───────────────────────────────────────
# MINERU_API_KEY=your_key_here

# ── NCBI / PubMed ───────────────────────────────────────────
# NCBI_API_KEY=your_key_here
# NCBI_EMAIL=your_email

# ── LangSmith ────────────────────────────────────────────────
# LANGSMITH_API_KEY=your_key_here
# LANGSMITH_PROJECT=metaagent

# ── Provider profiles: OpenRouter ───────────────────────────
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# ── Provider profiles: Lab API 1 ────────────────────────────
# LAB_BASE_URL=http://8.130.18.34:5000/v1
# LAB_API_KEY=empty
# LAB_MODEL=deepseek-3.2

# ── Provider profiles: Lab API 2 ────────────────────────────
# LAB_BASE_URL_2=https://10.140.158.153:1020/dsv3/all/v1/
# LAB_API_KEY_2=your_lab2_key_here
# LAB_MODEL_2=deepseek-v3-huawei-910b

# ── Provider profiles: Boyue ────────────────────────────────
# BOYUE_BASE_URL=http://host.example/v1
# BOYUE_API_KEY=your_boyue_key_here
# BOYUE_MODEL=deepseek-v4-pro

# ── Provider profiles: custom OpenAI-compatible endpoint ────
# Choose any provider name and define uppercase env vars from that name.
# Example for LLM_PROVIDER=my-gpu:
# MY_GPU_BASE_URL=https://host.example/v1
# MY_GPU_API_KEY=your_key_here
# MY_GPU_MODEL=provider-native-model-id
