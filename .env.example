# MetaAgent-Epi configuration template — copy to .env.local and fill in

# ── System proxy ────────────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1

# ── LLM defaults ────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0.1

# ── MinerU PDF Parser ───────────────────────────────────────
# MINERU_API_KEY=your_key_here

# ── NCBI / PubMed ───────────────────────────────────────────
# NCBI_API_KEY=your_key_here
# NCBI_EMAIL=your_email

# ── LangSmith ────────────────────────────────────────────────
# LANGSMITH_API_KEY=your_key_here
# LANGSMITH_PROJECT=metaagent
